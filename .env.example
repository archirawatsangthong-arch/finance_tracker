# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Supabase Dashboard → Project Settings → API Keys
# ใช้ได้เฉพาะ publishable key (sb_publishable_...) หรือ anon key — ห้ามใส่ secret / service_role key เด็ดขาด
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
